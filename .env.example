# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Optional - Required if using Claude (Claude 3.5 Sonnet / Haiku)
ANTHROPIC_API_KEY="sk-ant-api03-..."

# OPENAI_API_KEY: Optional - Required if using OpenAI (GPT-4o / GPT-4o-mini)
OPENAI_API_KEY="sk-proj-..."

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PIN: Master supervisor PIN code for admin management (default: 000000)
ADMIN_PIN="000000"
